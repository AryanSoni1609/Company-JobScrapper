# ── Secrets & personal files — NEVER commit these ────────────────────────────
.env
google_credentials.json
gmail_credentials.json
gmail_token.json
*.json
!.vscode/*.json

# Personal resume details, resume template and job preferences
# (commit only the *.example.* versions)
resume_details.md
job_preference.md
templates/resume_template.docx

# ── Runtime output — generated by the scraper ─────────────────────────────────
output/*
!output/.gitkeep
data/*
!data/.gitkeep
resumes/*
!resumes/.gitkeep
logs/*
!logs/.gitkeep
*.csv
*.db
*.sqlite3
*.log

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/

# Virtual environments (the project venv is named "jobs")
jobs/
.venv/
venv/
env/

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp

# .env.example
# Copy this file to .env and fill in your values:
#     cp .env.example .env        (macOS / Linux / Git Bash)
#     copy .env.example .env      (Windows cmd / PowerShell)
# .env is gitignored — never commit it.

# ── Google Sheets (service account) ──────────────────────────────────────────
# Spreadsheet ID from the URL: https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here
# Service account key JSON (Cloud Console → IAM → Service Accounts → Keys).
# Share the spreadsheet with the service account's email as Editor.
GOOGLE_CREDENTIALS_PATH=google_credentials.json
# Tab names (defaults shown). Tabs are created if missing; rows are only ever appended.
SHEET_COMPANIES_TAB=Companies
SHEET_NO_ATS_TAB=Companies with no ATS
SHEET_JOBS_TAB=Jobs
SHEET_APPLICATIONS_TAB=Applications

# ── Email notifications (Gmail) ──────────────────────────────────────────────
# EMAIL_METHOD = gmail_api (OAuth) or smtp (Gmail App Password)
EMAIL_METHOD=gmail_api
# Address the digest is sent to, and the sender (your Gmail address)
NOTIFY_EMAIL_TO=you@gmail.com
NOTIFY_EMAIL_FROM=you@gmail.com

# gmail_api: OAuth client JSON (Cloud Console → APIs & Services → Credentials →
# OAuth client ID → Desktop app). The token is created on first run.
GMAIL_CREDENTIALS_PATH=gmail_credentials.json
GMAIL_TOKEN_PATH=gmail_token.json

# smtp: create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Max tailored resumes attached to one digest email (Gmail limit is 25 MB)
DIGEST_MAX_ATTACHMENTS=15
# Send the 21:00 email even when nothing new was found ("all quiet" mail)
DIGEST_SEND_EMPTY=yes

# ── Schedule ─────────────────────────────────────────────────────────────────
TIMEZONE=Asia/Kolkata
# Daily digest time (24h, in TIMEZONE)
DIGEST_TIME=21:00
# How often to scan all companies for new jobs (hours)
SCAN_INTERVAL_HOURS=6
# Re-sync the LeetCode company list every N days
COMPANY_SYNC_INTERVAL_DAYS=7

# ── Company sources ──────────────────────────────────────────────────────────
LEETCODE_REPO=liquidslr/leetcode-company-wise-problems
# Optional GitHub token (raises the API rate limit from 60 to 5000 req/hour)
GITHUB_TOKEN=
# Max new companies to run ATS detection on per sync (detection is slow)
DETECTION_BATCH_SIZE=60

# ── Personal files (gitignored; copy from the *.example.* versions) ─────────
JOB_PREFERENCE_PATH=job_preference.md
RESUME_DETAILS_PATH=resume_details.md
# Optional .docx template with docxtpl tags (see templates/README.md).
# Leave empty to use the built-in layout.
RESUME_TEMPLATE_PATH=

# ── Paths ────────────────────────────────────────────────────────────────────
OUTPUT_DIR=./output
DATA_DIR=./data
RESUMES_DIR=./resumes
LOG_DIR=./logs

# ── MCP server ───────────────────────────────────────────────────────────────
# stdio (for Claude Desktop / Claude Code) or streamable-http (for a server)
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8765

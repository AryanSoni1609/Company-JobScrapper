# .env.example
# Copy this file to .env and fill in your values.
# Never commit .env to git — it's in .gitignore.

# Required: your Google Sheets spreadsheet ID
# Found in the URL: https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Required: path to your Google service account credentials JSON file
# Download from Google Cloud Console → IAM → Service Accounts → Keys
GOOGLE_CREDENTIALS_PATH=google_credentials.json

# Optional: where to write output CSV files (default: ./output)
# OUTPUT_DIR=./output
